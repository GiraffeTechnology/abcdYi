# MyAivan web entry. Normally leave VITE_MYAIVAN_URL empty: the build reads the
# port MyAivan chose automatically from MYAIVAN_PORT_FILE (its AIVAN_PORT_FILE)
# and combines it with MYAIVAN_PUBLIC_HOST. Port 443 is never used (SSH on CTYun).
# Never put credentials, API keys, tenant IDs, or business data in these values.
VITE_MYAIVAN_URL=
MYAIVAN_PUBLIC_HOST=
MYAIVAN_PUBLIC_SCHEME=
MYAIVAN_PORT_FILE=
# Optional dev-server port; empty picks a free port automatically.
VITE_DEV_PORT=
