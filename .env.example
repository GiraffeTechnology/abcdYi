# Database
DATABASE_URL=postgresql+asyncpg://giraffe:giraffe@localhost:5432/apparel_textile

# Auth
# SECRET_KEY MUST be overridden in production with a long random string
# (>= 32 chars). The API fails fast on startup if this placeholder value or
# any value shorter than 32 characters is used. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (optional — system works without LLM provider)
LLM_PROVIDER=stub
OPENAI_API_KEY=
QWEN_API_KEY=


# Standalone GLTG service
GLTG_API_BASE_URL=http://localhost:8090
GLTG_API_TIMEOUT_SECONDS=30
# Required when the embedded Aivan client uses GLTG_API_VERSION=v2.
GLTG_SERVICE_AUTH_SECRET=

# Selected replaceable private-data provider for Aivan-confirmed order imports.
# Reuse the same endpoint, service identity, and tenant namespace as Aivan.
# Set a stable provider ID. Never change it just because the endpoint moves.
ABCDYI_PRIVATE_DATA_PROVIDER_ID=
GIRAFFE_DB_BASE_URL=
GIRAFFE_DB_SERVICE_AUTH_SECRET=
# Optional operator-owned JSON mapping: local tenant UUID -> provider tenant ID.
# Omit for identical tenant IDs. Mappings must be one-to-one; no request override.
ABCDYI_PRIVATE_DATA_TENANT_MAP=

# GPM's context retriever uses service auth, not the legacy Bearer API key.
# This overrides GIRAFFE_DB_SERVICE_AUTH_SECRET for the configured GPM provider.
GPM_GIRAFFE_DB_SERVICE_AUTH_SECRET=
